<script>
const ARTICLE_ID = 'why-we-still-need-novels';
const SUPABASE_URL = 'https://evhceswvapszaghnvmxl.supabase.co';
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV2aGNlc3d2YXBzemFnaG52bXhsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc3OTQwNzMsImV4cCI6MjA5MzM3MDA3M30.yV7tavgR7JKc45uSGtS8Lf6m1ZMuuvQ23hmAb8n6k3A';
const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

const VOCAB = [
  { word: "prophesied",        def: "predicted something would happen, often as a warning" },
  { word: "isolation",         def: "being alone, separated from others" },
  { word: "attention span",    def: "how long someone can pay attention to something" },
  { word: "shrunk",            def: "became smaller; reduced in size" },
  { word: "endures",           def: "continues to exist; survives over time" },
  { word: "miracle",           def: "something amazing or surprising, especially if hard to achieve" },
  { word: "instant gratification", def: "immediate satisfaction with no waiting" },
  { word: "wisdom",            def: "deep understanding gained from experience and reflection" },
  { word: "arrogant",          def: "having too high an opinion of yourself; proud in an unpleasant way" },
  { word: "empathy",           def: "the ability to understand and share another person's feelings" },
  { word: "demographics",      def: "the make-up of a population (age, gender, etc.)" },
  { word: "jingoism",          def: "extreme support for your own country, often hostile to others" },
  { word: "populism",          def: "a political approach that claims to represent ordinary people against the elite" },
  { word: "dismantles",        def: "takes apart; breaks down a structure or idea" },
  { word: "predates",          def: "came before in time; existed earlier than" },
  { word: "burdened",          def: "weighed down by something difficult; deeply troubled" },
  { word: "embark on",         def: "begin a journey or new venture" },
  { word: "prolong",           def: "make something last longer" },
  { word: "triumphant",        def: "having achieved a great victory; celebrating success" },
  { word: "protagonist",       def: "the main character in a story" },
  { word: "evolves",           def: "changes gradually into something better or more developed" },
  { word: "attain",            def: "achieve or reach (a goal, level)" },
  { word: "perished",          def: "died, especially in a sudden or violent way" },
  { word: "resilience",        def: "the ability to recover from difficulties; toughness of mind" }
];

let currentUser = null;
let quizScore = 0;
let quizAnswered = 0;
let quizWords = [];

// ===== AUTH =====
async function initAuth() {
  const { data: { session } } = await sb.auth.getSession();
  if (session) { currentUser = session.user; showApp(); }
}
async function doSignIn() {
  const email = document.getElementById('auth-email').value.trim();
  const pass = document.getElementById('auth-pass').value;
  const btn = document.getElementById('auth-btn');
  if (!email || !pass) { showAuthMsg('Enter email and password.', true); return; }
  btn.disabled = true; btn.textContent = 'Signing in…';
  const { data, error } = await sb.auth.signInWithPassword({ email, password: pass });
  btn.disabled = false; btn.textContent = 'Sign In';
  if (error) { showAuthMsg(error.message, true); return; }
  currentUser = data.user;
  showApp();
}
function showAuthMsg(text, isErr) {
  const el = document.getElementById('auth-msg');
  el.textContent = text;
  el.className = 'auth-msg ' + (isErr ? 'error' : 'success');
  el.style.display = 'block';
}
function showApp() {
  document.getElementById('auth-overlay').style.display = 'none';
  const name = currentUser.user_metadata?.name || currentUser.email.split('@')[0];
  document.getElementById('user-pill').textContent = '👋 ' + name.split(' ')[0];
  buildQuiz();
}
async function doSignOut() {
  await sb.auth.signOut();
  location.reload();
}

// ===== FONT SIZE =====
const FONT_SIZES = [0.85, 0.95, 1.05, 1.15, 1.25, 1.4];
let fontIdx = 2;
function loadFontPref() {
  const saved = parseInt(localStorage.getItem('ef_font_idx'));
  if (!isNaN(saved) && saved >= 0 && saved < FONT_SIZES.length) fontIdx = saved;
  applyFont();
}
function changeFont(delta) {
  fontIdx = Math.max(0, Math.min(FONT_SIZES.length - 1, fontIdx + delta));
  localStorage.setItem('ef_font_idx', fontIdx);
  applyFont();
}
function applyFont() {
  document.documentElement.style.setProperty('--article-font-size', FONT_SIZES[fontIdx] + 'rem');
  document.getElementById('font-down').disabled = (fontIdx === 0);
  document.getElementById('font-up').disabled = (fontIdx === FONT_SIZES.length - 1);
}

// ===== DARK MODE =====
function loadThemePref() {
  if (localStorage.getItem('ef_dark') === '1') {
    document.body.classList.add('dark-mode');
    document.getElementById('theme-toggle').textContent = '☀';
  }
}
function toggleTheme() {
  const dark = document.body.classList.toggle('dark-mode');
  localStorage.setItem('ef_dark', dark ? '1' : '0');
  document.getElementById('theme-toggle').textContent = dark ? '☀' : '🌙';
}

// ===== VOCAB TAP (mobile) =====
document.addEventListener('click', (e) => {
  const v = e.target.closest('.vocab');
  if (v) {
    document.querySelectorAll('.vocab.tap-active').forEach(o => { if (o !== v) o.classList.remove('tap-active'); });
    v.classList.toggle('tap-active');
    e.stopPropagation();
  } else {
    document.querySelectorAll('.vocab.tap-active').forEach(o => o.classList.remove('tap-active'));
  }
});

// ===== QUIZ =====
function shuffle(arr) {
  return arr.map(v => [Math.random(), v]).sort((a,b)=>a[0]-b[0]).map(p => p[1]);
}

function buildQuiz() {
  // pick 12 random vocab words (out of 24) to keep quiz manageable
  quizWords = shuffle(VOCAB.slice()).slice(0, 12);

  const list = document.getElementById('quiz-list');
  list.innerHTML = '';
  const allDefs = VOCAB.map(v => v.def);

  quizWords.forEach((item, i) => {
    const others = allDefs.filter(d => d !== item.def);
    const distractors = shuffle(others).slice(0, 3);
    const options = shuffle([item.def, ...distractors]);

    const card = document.createElement('div');
    card.className = 'quiz-q';
    card.id = 'q-' + i;
    card.innerHTML = `
      <div class="quiz-q-num">Word ${i+1} of ${quizWords.length}</div>
      <div class="quiz-word">${item.word}</div>
      <div class="quiz-options">
        ${options.map(opt => `
          <button class="quiz-opt" data-q="${i}" data-correct="${item.def === opt ? '1' : '0'}">${opt}</button>
        `).join('')}
      </div>
      <div class="quiz-feedback" id="fb-${i}"></div>
    `;
    list.appendChild(card);
  });

  document.querySelectorAll('.quiz-opt').forEach(btn => {
    btn.addEventListener('click', handleAnswer);
  });
}

function handleAnswer(e) {
  const btn = e.currentTarget;
  const qIdx = parseInt(btn.dataset.q);
  const isCorrect = btn.dataset.correct === '1';
  const card = document.getElementById('q-' + qIdx);

  card.querySelectorAll('.quiz-opt').forEach(o => {
    o.disabled = true;
    if (o.dataset.correct === '1') o.classList.add('correct');
  });
  if (!isCorrect) btn.classList.add('wrong');

  const fb = document.getElementById('fb-' + qIdx);
  if (isCorrect) {
    fb.className = 'quiz-feedback show ok';
    fb.textContent = '✓ Correct!';
    quizScore++;
  } else {
    fb.className = 'quiz-feedback show bad';
    fb.textContent = '✗ Not quite. The correct definition is highlighted.';
  }

  quizAnswered++;
  document.getElementById('quiz-progress').style.width = (quizAnswered / quizWords.length * 100) + '%';

  if (quizAnswered === quizWords.length) {
    setTimeout(showQuizResult, 400);
  }
}

function showQuizResult() {
  const r = document.getElementById('quiz-result');
  document.getElementById('result-score').textContent = quizScore + ' / ' + quizWords.length;
  r.classList.add('show');
  r.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

// ===== MARK AS READ =====
async function markAsRead() {
  const btn = document.getElementById('mark-read-btn');
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try {
    await sb.from('article_reads').upsert({
      user_id: currentUser.id,
      article_id: ARTICLE_ID,
      completed_at: new Date().toISOString()
    }, { onConflict: 'user_id,article_id' });
    btn.textContent = '✓ Marked as Read';
  } catch (e) {
    btn.disabled = false;
    btn.textContent = 'Try again';
    console.warn('Save failed:', e);
  }
}

// ===== BOOT =====
loadFontPref();
loadThemePref();
initAuth();
</script>
